    <hal format="aidl" optional="true">
        <name>android.hardware.health</name>
        <version>3</version>
        <interface>
            <name>IHealth</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.lineage.health</name>
        <interface>
            <name>IChargingControl</name>
            <instance>default</instance>
        </interface>
    </hal>
</compatibility-matrix>
