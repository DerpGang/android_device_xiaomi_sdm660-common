        </interface>
    </hal>
    <hal format="hidl" optional="true">
        <name>vendor.lineage.livedisplay</name>
        <transport>hwbinder</transport>
        <version>2.0</version>
        <interface>
            <name>IDisplayModes</name>
            <instance>default</instance>
        </interface>
